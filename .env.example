# Copie este arquivo para .env e preencha com suas chaves reais
# NUNCA commite o arquivo .env no Git!

# --- SUPABASE (Frontend - públicas) ---
# Obtenha em: https://supabase.com → Settings → API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- STRIPE (Frontend - chave pública) ---
# Obtenha em: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx

# --- BACKEND ONLY (Configurar no Vercel Dashboard → Settings → Environment Variables) ---
# IMPORTANTE: Estas NÃO vão no arquivo .env local. Configure direto no Vercel!
#
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
